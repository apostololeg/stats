@import '~theme'
json('../../constants/layoutBreakpoints.json')

html
body
  background-color var(--decent-color)

html
body
.root
  height calc(100 * var(--vh))
  width 100%
  overflow hidden

.root
  display flex
  // flex-direction column

.sidebar
  position relative
  display flex
  flex-direction column
  flex-shrink 0
  width 300px
  max-width 300px
  padding var(--p-1)
  background-color var(--accent-color-alpha-50)

.list
  flex-grow 1
  padding var(--indent-s)
  overflow hidden

.listItem
  width calc(100% - 4px)
  flex-grow 1
  margin 2px
  justify-content flex-start
  text-align left

  & + &
    margin-top var(--indent-s)

  &.isActive
    background-color var(--active-color-alpha-200)
    box-shadow 0 0 0 2px var(--active-color-alpha-500)

.sidebarLiveLink
  margin-bottom var(--p-2)
  align-items center
  gap 6px
  overflow visible

  &.isLive
    background-color var(--success-color-alpha-100)
    box-shadow 0 0 0 2px var(--success-color-alpha-500)

.liveDot
  position relative
  flex-shrink 0
  width 8px
  height 8px
  border-radius 50%
  background-color var(--success-color-alpha-500)

  &::after
    content ''
    position absolute
    inset 0
    border-radius inherit
    background-color inherit
    pointer-events none
    animation liveDotPulse 3s ease-out infinite

@keyframes liveDotPulse
  0%
    transform scale(1)
    opacity .7
  25%
    transform scale(4)
    opacity 0
  100%
    transform scale(4)
    opacity 0

.darkThemeCheckbox
  position relative
  display flex
  justify-content center
  align-items center
  height 80px
  width 100%
  margin 0 auto
  font-size 40px

  & > label
    position absolute
    width 60px
    height 60px
    border-radius 50%
    transition background-color .2s ease-out

    & > div
      opacity 0 !important

    &:hover
      background-color var(--accent-color-alpha-100)

.content
  position relative
  flex-grow 1
  min-width 0

.version
  position absolute
  bottom var(--p-3)
  right var(--p-3)
  text-align center
  font-size 80%
  color var(--accent-color-alpha-500)

  &::before
    content 'v'

@media screen and (max-width: unit(MOBILE, 'px'))
  .sidebar
    position fixed
    top 0
    left 0
    bottom 0
    z-index 100
    background-color var(--decent-color-alpha-900)
    backdrop-filter blur(10px)
    transform translateX(-100%)
    transition .2s ease-out
    transition-property transform, box-shadow

    &.isOpen
      transform translateX(0)
      box-shadow 2px 0 0 0 var(--accent-color-alpha-500)

  .content
    padding-top 80px
    overflow-x hidden
