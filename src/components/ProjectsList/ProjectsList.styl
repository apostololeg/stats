.root
  display flex
  flex-direction column
  gap var(--p-1)

  &.inline
    flex-direction row
    flex-wrap wrap
    gap 2px

.item
  display flex
  align-items center
  margin-left 2px
  margin-right 2px

  & > button
    padding-right var(--p-2)

.actions
  display flex
  align-items center
  flex-shrink 0
  gap 2px
  opacity 0
  pointer-events none

  .item:hover &
    opacity 1
    pointer-events auto


.footer
  display flex
  justify-content center

