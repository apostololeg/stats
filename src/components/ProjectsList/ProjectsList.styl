.root
  display flex
  flex-direction column
  gap var(--indent-s)

  &.inline
    flex-direction row
    flex-wrap wrap
    gap 2px

.item
  display flex
  justify-content space-between
  align-items center
  margin-left 2px
  margin-right 2px
  // margin-top var(--indent-s)

  // & + &
  //   margin-top var(--indent-s)

.actions
  position absolute
  right var(--indent-m)
  display flex
  align-items center
  gap 2px
  opacity 0

  .item:hover &
    opacity 1


.footer
  display flex
  justify-content center

