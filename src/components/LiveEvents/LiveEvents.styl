json('../../constants/layoutBreakpoints.json')

.root
  margin-top 0
  min-width 0
  max-width 100%

.toolbar
  display flex
  align-items center
  justify-content space-between
  gap 10px
  margin-bottom var(--indent-s)
  min-width 0

.controls
  display flex
  align-items center
  gap 10px
  min-width 0
  font-size 0

.datePicker
  max-width 300px
  min-width 300px

.isLoading
  opacity 0.45

.charts
  // Pull the charts left so the Y-axis labels sit as close to the edge as the charts' right side.
  width calc(100% + 25px)
  margin-left -25px

  // `> div` beats the chart roots' equal-specificity width/margin rules.
  > div
    width 100%
    margin-left 0
    min-width 400px

.status
  flex-shrink 0
  font-size 80%
  padding 2px 8px
  border-radius 999px
  background-color var(--accent-color-alpha-50)

  &.connected
    background-color var(--success-color-alpha-100, var(--accent-color-alpha-100))
    box-shadow 0 0 0 2px var(--success-color-alpha-500, var(--accent-color-alpha-500))

  &.disconnected,
  &.connecting
    background-color var(--warning-color-alpha-100, var(--accent-color-alpha-100))

.tableWrap
  position relative
  height calc(100 * var(--vh) - 540px)
  min-height 220px
  margin-top var(--indent-s)
  width 100%
  overflow hidden
  user-select text
  -webkit-user-select text

  *
    user-select text
    -webkit-user-select text

  > div
    height 100%
    border-radius 14px
    overflow hidden

    > div:first-child
      height 100%

  table
    border-collapse collapse
    border-spacing 0

    tbody tr
      transition 5s background-color

      &.arrivedWhileHidden
        background-color var(--warning-color-alpha-100)

  thead
    background-color var(--decent-color-alpha-900)
    backdrop-filter blur(10px)

    th
      vertical-align top

  th,
  td
    border none
    padding-top 2px
    padding-bottom 2px

  // Size columns to their content instead of stretching them across the
  // full width: every column takes 1% (shrink-to-fit) and the last one
  // absorbs the leftover space.
  th,
  td
    width 1%
    white-space nowrap
    padding-right 1.5em

  th:last-child,
  td:last-child
    width auto

  th:nth-child(2),
  td:nth-child(2)
    min-width 0

.headerCell
  display grid
  grid-template-columns max-content auto
  align-items center
  column-gap 4px
  row-gap 4px
  min-width 0

  > span
    grid-column 1
    grid-row 1
    white-space nowrap

.filterButton
  grid-column 2
  grid-row 1
  justify-self start
  flex-shrink 0

.filterSelect
  min-width 8em
  max-width 12em

.filterChips
  grid-column 1 / -1
  grid-row 2
  display flex
  flex-wrap wrap
  gap 4px
  min-width 0

.filterChip
  justify-self start
  max-width 9em
  min-width 0

  span
    display block
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.cellEllipsis
  display block
  max-width 40em
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.projectLink
  display block
  max-width 14em
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.empty
  position absolute
  top 3em
  left 0
  right 0
  margin 0
  text-align center
  opacity 0.6
  pointer-events none

.table
  border-radius 14px
  overflow hidden

@media screen and (max-width: unit(MOBILE, 'px'))
  .toolbar
    flex-wrap wrap

  .datePicker
    min-width 0
    max-width 100%

  .tableWrap
    width 100%
    max-width 100%
    overflow-x auto
    -webkit-overflow-scrolling touch

  .table
    overflow visible

  .tableWrap table
    width max-content
    min-width 100%
