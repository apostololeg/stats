json('../../constants/layoutBreakpoints.json')

.root
  margin-top 0
  min-width 0
  max-width 100%

.toolbar
  display flex
  align-items center
  justify-content space-between
  gap 10px
  margin-bottom var(--indent-s)
  min-width 0

.controls
  display flex
  align-items center
  gap 10px
  min-width 0
  font-size 0

.datePicker
  max-width 300px
  min-width 300px

.isLoading
  opacity 0.45

.charts
  // `> div` beats the chart roots' equal-specificity width/margin rules.
  > div
    width 100%
    margin-left 0
    min-width 400px

.status
  flex-shrink 0
  font-size 80%
  padding 2px 8px
  border-radius 999px
  background-color var(--accent-color-alpha-50)

  &.connected
    background-color var(--success-color-alpha-100, var(--accent-color-alpha-100))
    box-shadow 0 0 0 2px var(--success-color-alpha-500, var(--accent-color-alpha-500))

  &.disconnected,
  &.connecting
    background-color var(--warning-color-alpha-100, var(--accent-color-alpha-100))

.tableWrap
  height calc(100 * var(--vh) - 540px)
  min-height 220px
  margin-top var(--indent-s)
  width 100%
  overflow hidden

  > div
    height 100%
    border-radius 14px
    overflow hidden

    > div:first-child
      height 100%

  table
    border-collapse collapse
    border-spacing 0

    tbody tr
      transition 5s background-color

      &.arrivedWhileHidden
        background-color var(--warning-color-alpha-100)

  thead
    background-color var(--decent-color-alpha-900)
    backdrop-filter blur(10px)

    th
      vertical-align top

  th,
  td
    border none
    padding-top 2px
    padding-bottom 2px

  th:nth-child(1),
  td:nth-child(1)
    min-width 7.5em
    white-space nowrap

  th:nth-child(2),
  td:nth-child(2)
    min-width 5em

  th:nth-child(3),
  td:nth-child(3)
    min-width 8em

  th:nth-child(4),
  td:nth-child(4)
    min-width 4.5em
    white-space nowrap

  th:nth-child(5),
  td:nth-child(5)
    min-width 6em

  th:nth-child(6),
  td:nth-child(6)
    min-width 4.5em
    white-space nowrap

.headerCell
  display grid
  grid-template-columns max-content minmax(0, 1fr)
  align-items center
  column-gap 4px
  row-gap 4px
  min-width 0

  > span
    grid-column 1
    grid-row 1
    white-space nowrap

.filterButton
  grid-column 2
  grid-row 1
  justify-self start
  flex-shrink 0

.filterSelect
  min-width 8em
  max-width 12em

.filterChips
  grid-column 1 / -1
  grid-row 2
  display flex
  flex-wrap wrap
  gap 4px
  min-width 0

.filterChip
  justify-self start
  max-width 9em
  min-width 0

  span
    display block
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.cellEllipsis
  display block
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.projectLink
  display block
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.empty
  opacity 0.6
  margin-top var(--indent-s)

.table
  border-radius 14px
  overflow hidden

@media screen and (max-width: unit(MOBILE, 'px'))
  .toolbar
    flex-wrap wrap

  .datePicker
    min-width 0
    max-width 100%

  .tableWrap
    width 100%
    max-width 100%
    overflow-x auto
    -webkit-overflow-scrolling touch

  .table
    overflow visible

  .tableWrap table
    width max-content
    min-width 100%
